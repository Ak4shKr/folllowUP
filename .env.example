# ---------------------------------------------------------------------------
# flwUp configuration. Copy to `.env` and fill in. Never commit `.env`.
# Every value here is a safe default or a blank that must be set locally.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/flwup

# --- App --------------------------------------------------------------------
APP_ENV=development                 # development | test | production
APP_TIMEZONE=Asia/Kolkata           # default display timezone; campaigns may override
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                       # false = human-readable console logs

# --- Security ---------------------------------------------------------------
# 32-byte urlsafe base64 Fernet key. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FLWUP_SECRET_KEY=
# Static API key for every /api/v1 route. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLWUP_API_KEY=
API_BIND_HOST=127.0.0.1             # do not expose publicly by default
API_BIND_PORT=8000
CORS_ORIGINS=                       # comma-separated; usually empty

# --- Send safety ------------------------------------------------------------
REQUIRE_EMAIL_APPROVAL=true         # false is dev-only; logs a startup warning
DAILY_SEND_LIMIT=50                 # hard global cap; startup fails above 50
FLWUP_PAUSED=false                  # global kill switch (also controllable via API)
PROVIDER_SEND_TIMEOUT_SECONDS=30
SEND_MAX_ATTEMPTS=3                 # transient errors only
SEND_BACKOFF_BASE_SECONDS=2         # 2s, 4s, 8s + jitter
CLAIM_TIMEOUT_SECONDS=300           # stale `sending`/`processing` reclaim window

# --- Scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=true
DISPATCH_INTERVAL_SECONDS=30        # find and send due messages
FOLLOWUP_INTERVAL_SECONDS=60        # find due follow-up tasks
RECONCILE_INTERVAL_SECONDS=600      # retry unknown_outcome resolution
REPLY_POLL_INTERVAL_SECONDS=900     # reply detection (Phase 3)
SCHEDULER_ADVISORY_LOCK_KEY=884422  # single-worker guarantee

# --- LLM --------------------------------------------------------------------
LLM_PROVIDER=ollama                 # ollama | openai
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.5                 # drafts 0.0-0.7; classification uses 0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=2
OLLAMA_BASE_URL=http://localhost:11434

# Optional cloud provider; leave blank when using Ollama.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Google OAuth / APIs ----------------------------------------------------
# Download the OAuth client JSON from Google Cloud Console (Desktop app type).
GOOGLE_CLIENT_SECRETS_FILE=credentials/client_secret.json
GOOGLE_TOKEN_FILE=credentials/token.enc      # encrypted with FLWUP_SECRET_KEY
GOOGLE_OAUTH_REDIRECT_HOST=127.0.0.1
GOOGLE_OAUTH_REDIRECT_PORT=8765

# --- Google Sheets import ---------------------------------------------------
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Contacts!A:Z
SHEET_HEADER_MAP=                   # optional "name:Name,email:Email,company:Company" override

# --- Import behavior --------------------------------------------------------
IMPORT_STRIP_PLUS_TAGS=false        # keep false: merging distinct people is worse than a duplicate
IMPORT_MAX_INVALID_ROWS=200         # abort if a sheet is mostly garbage
