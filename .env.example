# ---------------------------------------------------------------------------
# flwUp configuration. Copy to `.env` and fill in. Never commit `.env`.
# Add a key here in the same change that adds it to `app/core/env.py`.
# ---------------------------------------------------------------------------

# --- App --------------------------------------------------------------------
APP_NAME=flwUp
APP_ENV=development
LOG_LEVEL=INFO

# --- Server -----------------------------------------------------------------
API_BIND_HOST=127.0.0.1
API_BIND_PORT=8000

# --- Database ---------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=flwup
PG_POOL_SIZE=5
PG_MAX_OVERFLOW=10
PG_POOL_TIMEOUT=30
PG_ECHO=false

# --- Safety -----------------------------------------------------------------
REQUIRE_EMAIL_APPROVAL=true
